{
  "name": "@davstack/peek",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Peek at concise, agent-friendly folder summaries.",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "test": "pnpm -w exec vitest run --project peek"
  },
  "bin": {
    "peek": "./bin/davstack-peek.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli-spec": {
      "types": "./dist/cli-spec.d.ts",
      "default": "./dist/cli-spec.js"
    }
  },
  "files": [
    "bin/**",
    "dist/**",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@davstack/cli-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
